//! SHA-256 in plain Cairo: no syscall, so every round is constrained by the proof.

#[feature("bounded-int-utils")]
use core::internal::bounded_int::{
    self, AddHelper, BoundedInt, DivRemHelper, MulHelper, UnitInt, upcast,
};

/// Sha256 hasher state.
type Sha256State = (u32, u32, u32, u32, u32, u32, u32, u32);
/// Cairo implementation of the corelib `compute_sha256_u32_array` function.
pub fn compute_sha256_u32_array(
    mut input: Array<u32>, last_input_word: u32, last_input_num_bytes: u32,
) -> [u32; 8] {
    add_sha256_padding(ref input, last_input_word, last_input_num_bytes);

    let mut data = input.span();
    let mut state = h;

    while let Option::Some(chunk) = data.multi_pop_front::<16>() {
        state = sha256_inner((*chunk).unbox().span(), state);
    }

    let (d0, d1, d2, d3, d4, d5, d6, d7) = state;
    [d0, d1, d2, d3, d4, d5, d6, d7]
}

/// Adds padding to the input array for SHA-256. The padding is defined as follows:
/// 1. Append a single bit with value 1 to the end of the array.
/// 2. Append zeros until the length of the array is 448 mod 512.
/// 3. Append the length of the array in bits as a 64-bit number.
/// use last_input_word when the number of bytes in the last input word is less than 4.
fn add_sha256_padding(ref arr: Array<u32>, last_input_word: u32, last_input_num_bytes: u32) {
    let len = arr.len();
    if last_input_num_bytes == 0 {
        arr.append(0x80000000);
    } else {
        let (q, m, pad) = if last_input_num_bytes == 1 {
            (0x100, 0x1000000, 0x800000)
        } else if last_input_num_bytes == 2 {
            (0x10000, 0x10000, 0x8000)
        } else {
            (0x1000000, 0x100, 0x80)
        };
        let (_, r) = core::integer::u32_safe_divmod(last_input_word, q);
        arr.append(r * m + pad);
    }

    let mut remaining = 16 - ((arr.len() + 1) % 16);
    append_zeros(ref arr, remaining);

    arr.append(len * 32 + last_input_num_bytes * 8);
}

/// Appends `count` zeros to the array.
fn append_zeros(ref arr: Array<u32>, count: u32) {
    if count == 0 {
        return;
    }
    arr.append(0);
    if count == 1 {
        return;
    }
    arr.append(0);
    if count == 2 {
        return;
    }
    arr.append(0);
    if count == 3 {
        return;
    }
    arr.append(0);
    if count == 4 {
        return;
    }
    arr.append(0);
    if count == 5 {
        return;
    }
    arr.append(0);
    if count == 6 {
        return;
    }
    arr.append(0);
    if count == 7 {
        return;
    }
    arr.append(0);
    if count == 8 {
        return;
    }
    arr.append(0);
    if count == 9 {
        return;
    }
    arr.append(0);
    if count == 10 {
        return;
    }
    arr.append(0);
    if count == 11 {
        return;
    }
    arr.append(0);
    if count == 12 {
        return;
    }
    arr.append(0);
    if count == 13 {
        return;
    }
    arr.append(0);
    if count == 14 {
        return;
    }
    arr.append(0);
    if count == 15 {
        return;
    }
    arr.append(0);
}

// The compression below replaces Raito's, which builds each rotation from a u32 division, an
// overflowing u32 multiplication and an OR, and adds with overflow-checked u32 additions. Here
// words are bounded integers whose ranges the compiler tracks: a rotation is one division by 2^n
// plus a multiply-add that cannot overflow, a sum is exact and reduced mod 2^32 once, and no value
// is range-checked twice. Ch and Maj use the three-operation forms. Same function: checked against
// FIPS 180-4 vectors in the tests below, and against node's SHA-256 through every Merkle root the
// program recomputes. (Generated by zk/gen_sha256_fast.py, then `scarb fmt`.)

type B32 = BoundedInt<0, 0xffffffff>;
type P32 = UnitInt<0x100000000>;
const NZ_P32: NonZero<P32> = 0x100000000;

type S2 = BoundedInt<0, 0x1fffffffe>;
type S3 = BoundedInt<0, 0x2fffffffd>;
type S4 = BoundedInt<0, 0x3fffffffc>;
type S5 = BoundedInt<0, 0x4fffffffb>;
type S6 = BoundedInt<0, 0x5fffffffa>;
type S7 = BoundedInt<0, 0x6fffffff9>;
impl AddB32B32 of AddHelper<B32, B32> {
    type Result = S2;
}
impl AddS2B32 of AddHelper<S2, B32> {
    type Result = S3;
}
impl AddS3B32 of AddHelper<S3, B32> {
    type Result = S4;
}
impl AddS4B32 of AddHelper<S4, B32> {
    type Result = S5;
}
impl AddS5B32 of AddHelper<S5, B32> {
    type Result = S6;
}
impl AddS6B32 of AddHelper<S6, B32> {
    type Result = S7;
}
impl RedS2 of DivRemHelper<S2, P32> {
    type DivT = BoundedInt<0, 1>;
    type RemT = B32;
}
#[inline(always)]
fn red2(x: S2) -> u32 {
    let (_, r) = bounded_int::div_rem(x, NZ_P32);
    upcast(r)
}
impl RedS4 of DivRemHelper<S4, P32> {
    type DivT = BoundedInt<0, 3>;
    type RemT = B32;
}
#[inline(always)]
fn red4(x: S4) -> u32 {
    let (_, r) = bounded_int::div_rem(x, NZ_P32);
    upcast(r)
}
impl RedS6 of DivRemHelper<S6, P32> {
    type DivT = BoundedInt<0, 5>;
    type RemT = B32;
}
#[inline(always)]
fn red6(x: S6) -> u32 {
    let (_, r) = bounded_int::div_rem(x, NZ_P32);
    upcast(r)
}
impl RedS7 of DivRemHelper<S7, P32> {
    type DivT = BoundedInt<0, 6>;
    type RemT = B32;
}
#[inline(always)]
fn red7(x: S7) -> u32 {
    let (_, r) = bounded_int::div_rem(x, NZ_P32);
    upcast(r)
}
#[inline(always)]
fn b(x: u32) -> B32 {
    upcast(x)
}

// rotr(x, n) = (x mod 2^n) * 2^(32 - n) + x div 2^n; shr(x, n) = x div 2^n.
const NZ2: NonZero<UnitInt<0x4>> = 0x4;
impl D2 of DivRemHelper<u32, UnitInt<0x4>> {
    type DivT = BoundedInt<0, 0x3fffffff>;
    type RemT = BoundedInt<0, 0x3>;
}
const U2: UnitInt<0x40000000> = 0x40000000;
impl M2 of MulHelper<BoundedInt<0, 0x3>, UnitInt<0x40000000>> {
    type Result = BoundedInt<0, 0xc0000000>;
}
impl A2 of AddHelper<BoundedInt<0, 0xc0000000>, BoundedInt<0, 0x3fffffff>> {
    type Result = B32;
}
