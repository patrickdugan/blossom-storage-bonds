#[cfg(test)]
mod tests {
    use super::compute_sha256_u32_array;

    #[test]
    fn empty_and_abc() {
        assert_eq!(
            compute_sha256_u32_array(array![], 0, 0),
            [
                0xe3b0c442, 0x98fc1c14, 0x9afbf4c8, 0x996fb924, 0x27ae41e4, 0x649b934c, 0xa495991b,
                0x7852b855,
            ],
        );
        assert_eq!(
            compute_sha256_u32_array(array![], 0x616263, 3),
            [
                0xba7816bf, 0x8f01cfea, 0x414140de, 0x5dae2223, 0xb00361a3, 0x96177a9c, 0xb410ff61,
                0xf20015ad,
            ],
        );
    }

    #[test]
    fn two_blocks() {
        // "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" (56 bytes: padding spills).
        let w = array![
            0x61626364, 0x62636465, 0x63646566, 0x64656667, 0x65666768, 0x66676869, 0x6768696a,
            0x68696a6b, 0x696a6b6c, 0x6a6b6c6d, 0x6b6c6d6e, 0x6c6d6e6f, 0x6d6e6f70, 0x6e6f7071,
        ];
        assert_eq!(
            compute_sha256_u32_array(w, 0, 0),
            [
                0x248d6a61, 0xd20638b8, 0xe5c02693, 0x0c3e6039, 0xa33ce459, 0x64ff2167, 0xf6ecedd4,
                0x19db06c1,
            ],
        );
    }
