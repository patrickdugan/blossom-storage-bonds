@@ -89,3 +94,29 @@ impl<F: PrimeField> ConstraintSynthesizer<F> for DummyCircuit<F> {
         Ok(())
     }
 }
+
+fn bsb_groth16(dir: &str) -> RawProof {
+    use ark_bn254::{Fq, Fq2, Fr, G2Affine};
+    use std::str::FromStr;
+    let read = |f: &str| -> serde_json::Value {
+        serde_json::from_str(&std::fs::read_to_string(format!("{dir}/{f}")).unwrap()).unwrap()
+    };
+    let fq = |v: &serde_json::Value| Fq::from_str(v.as_str().unwrap()).unwrap();
+    let g1 = |v: &serde_json::Value| G1Affine::new(fq(&v[0]), fq(&v[1]));
+    let g2 = |v: &serde_json::Value| {
+        G2Affine::new(Fq2::new(fq(&v[0][0]), fq(&v[0][1])), Fq2::new(fq(&v[1][0]), fq(&v[1][1])))
+    };
+    let v = read("vk.json");
+    let vk = ark_groth16::VerifyingKey::<Bn254> {
+        alpha_g1: g1(&v["vk_alpha_1"]),
+        beta_g2: g2(&v["vk_beta_2"]),
+        gamma_g2: g2(&v["vk_gamma_2"]),
+        delta_g2: g2(&v["vk_delta_2"]),
+        gamma_abc_g1: v["IC"].as_array().unwrap().iter().map(g1).collect(),
+    };
+    let p = read("proof.json");
+    let proof = ark_groth16::Proof::<Bn254> { a: g1(&p["pi_a"]), b: g2(&p["pi_b"]), c: g1(&p["pi_c"]) };
+    let public = vec![Fr::from_str(read("public.json")[0].as_str().unwrap()).unwrap()];
+    eprintln!("bsb: Groth16 proof from {dir}, public input {}, IC len {}", public[0], vk.gamma_abc_g1.len());
+    RawProof { proof, public, vk }
+}
